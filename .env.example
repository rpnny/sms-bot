# ==========================================
# 运行模式
# ==========================================
RUN_MODE=paper                # paper | live
LOG_LEVEL=info                # debug | info | warn | error

# ==========================================
# Solana RPC (Helius 主, FluxRPC 备)
# ==========================================
HELIUS_API_KEY=
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=

FLUXRPC_URL=
FLUXRPC_WS_URL=

# ==========================================
# 钱包 (paper 模式只需要地址, live 需要私钥)
# ==========================================
BOT_WALLET_ADDRESS=
BOT_WALLET_KEYPAIR_PATH=      # 例如 ~/sms-bot-wallet.json (live 模式必填)

# ==========================================
# 第三方 API
# ==========================================
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1
BIRDEYE_API_KEY=              # 备用价格源, 可选

# ==========================================
# 通知 (可选)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# 策略参数 (可 override config/strategy.json)
# ==========================================
# MAX_CONCURRENT_POSITIONS=8
# DAILY_LOSS_LIMIT_SOL=6
